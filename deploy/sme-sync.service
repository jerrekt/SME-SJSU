[Unit]
Description=Pull SME site sources and rebuild if changed
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=sme
Group=sme
ExecStart=/var/lib/sme/sjsu-sme/deploy/sync.sh
NoNewPrivileges=true
# Mount-namespace sandboxing (ProtectSystem, PrivateTmp) is left out on purpose:
# it fails inside an unprivileged LXC without nesting. The container is the sandbox.
