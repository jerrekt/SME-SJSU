# /etc/sme/sme.env  -- the ONLY file a new owner needs to edit to repoint the site.
# After editing, run:  sudo systemctl start sme-sync   (or wait up to 1 minute)

# Where the site code lives (the club's repo). Public repo = no key needed.
SITE_REPO=https://github.com/jerrekt/SME-SJSU.git
SITE_BRANCH=main

# The Spartan Signs project repo (public). Feeds the "Latest updates" list.
SIGNS_REPO=https://github.com/jerrekt/Spartan-signs.git
